# 複製成 .env 並填入真實值。.env 已被 .gitignore 排除,絕不可提交。
#
# 讀取方式:直接 export,或用 `set -a; source .env; set +a`。
# 本 repo 為 public — 任何寫死在程式碼裡的密碼／權杖等同對外公開發佈。

# ── 會員資料密碼 ────────────────────────────────────────────
# 所有付費 .enc 的 AES 密碼,同時也是 login.html 要求會員輸入的密碼。
# 更換時請用 rotate_password.py 一併重新加密全部 .enc 並更新頁面內的 _PW_HASH:
#   python rotate_password.py --old '舊密碼' --new '新密碼' --update-html
MEMBER_DATA_PASSWORD=

# 輪換時暫時使用(rotate_password.py --new 的來源)
# MEMBER_DATA_PASSWORD_NEW=

# ── 通知管道 ────────────────────────────────────────────────
# scripts/portfolio_rs_discord.py 推送組合 RS 報告用
DISCORD_PORTFOLIO_WEBHOOK_URL=

# send_movers_report.py 推送每日 RS 上升榜用
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cloudflare Worker 伺服器端授權(選用,見 docs/server-auth.md)──
# 這兩個值請用 `wrangler secret put` 設定,不要放進 .env 以外的地方。
# MEMBER_PASSWORD=
# SESSION_SECRET=
